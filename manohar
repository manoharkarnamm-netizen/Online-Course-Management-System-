<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Online Course Management System</title>

  <style>
    :root {
      --background: #f2f5f9;
      --surface: #ffffff;
      --text: #222222;
      --muted: #667085;
      --primary: #1769aa;
      --primary-dark: #0d4f83;
      --border: #dce3eb;
      --danger: #c0392b;
      --success: #138a4b;
    }

    body.dark {
      --background: #121212;
      --surface: #1f1f1f;
      --text: #eeeeee;
      --muted: #b5b5b5;
      --primary: #4da3ff;
      --primary-dark: #1976d2;
      --border: #3c3c3c;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--background);
      color: var(--text);
      transition: background 0.3s, color 0.3s;
    }

    header {
      background: var(--primary);
      color: white;
      padding: 22px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    header h1 {
      margin: 0;
      font-size: 25px;
    }

    header p {
      margin: 6px 0 0;
    }

    .header-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    main {
      width: 90%;
      max-width: 1150px;
      margin: 30px auto;
    }

    .card,
    .course-card,
    .profile-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .card {
      padding: 25px;
      margin-bottom: 25px;
    }

    .card h2 {
      margin-top: 0;
    }

    .course-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .course-card {
      padding: 20px;
    }

    .course-card h3 {
      color: var(--primary);
      margin-top: 0;
    }

    .course-card p {
      line-height: 1.5;
      color: var(--muted);
    }

    .category {
      color: var(--primary) !important;
      font-weight: bold;
    }

    input,
    textarea {
      width: 100%;
      padding: 12px;
      margin: 7px 0;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font-size: 15px;
    }

    textarea {
      height: 90px;
      resize: vertical;
    }

    button {
      border: none;
      padding: 11px 17px;
      background: var(--primary);
      color: white;
      border-radius: 6px;
      cursor: pointer;
      font-size: 14px;
      margin-top: 8px;
    }

    button:hover {
      background: var(--primary-dark);
    }

    .secondary-button {
      background: #555;
    }

    .danger-button {
      background: var(--danger);
    }

    .success-button {
      background: var(--success);
    }

    .hidden {
      display: none !important;
    }

    .login-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: var(--background);
    }

    .login-box {
      width: 100%;
      max-width: 420px;
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 30px;
      border-radius: 14px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
    }

    .login-box h1 {
      text-align: center;
      color: var(--primary);
    }

    .demo-login {
      color: var(--muted);
      font-size: 13px;
      background: var(--background);
      padding: 10px;
      border-radius: 6px;
    }

    .toolbar {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    .toolbar input {
      flex: 1;
      min-width: 230px;
    }

    .user-info {
      font-size: 14px;
    }

    .enrollment-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      padding: 15px 0;
      border-bottom: 1px solid var(--border);
    }

    .enrollment-item p {
      color: var(--muted);
      margin-bottom: 0;
    }

    #message {
      position: fixed;
      right: 20px;
      bottom: 20px;
      background: #222;
      color: white;
      padding: 14px 20px;
      border-radius: 7px;
      display: none;
      z-index: 10;
    }

    .profile-card {
      padding: 20px;
      margin-bottom: 25px;
    }

    .profile-card h3 {
      margin-top: 0;
      color: var(--primary);
    }

    @media (max-width: 600px) {
      header {
        align-items: flex-start;
      }

      .enrollment-item {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

  <!-- Login Page -->
  <section id="loginPage" class="login-page">
    <div class="login-box">
      <h1>CourseLearn</h1>
      <p>Login to manage your online courses.</p>

      <form id="loginForm">
        <label for="loginEmail">Email</label>
        <input
          type="email"
          id="loginEmail"
          placeholder="Enter your email"
          required
        >

        <label for="loginPassword">Password</label>
        <input
          type="password"
          id="loginPassword"
          placeholder="Enter your password"
          minlength="6"
          required
        >

        <button type="submit">Login</button>
      </form>

      <p class="demo-login">
        Demo login:<br>
        Email: admin@example.com<br>
        Password: password123
      </p>
    </div>
  </section>

  <!-- Main Application -->
  <section id="appPage" class="hidden">

    <header>
      <div>
        <h1>Online Course Management System</h1>
        <p>Learn new skills and manage your courses.</p>
      </div>

      <div class="header-actions">
        <span id="userInfo" class="user-info"></span>
        <button id="themeButton" class="secondary-button">
          Dark Theme
        </button>
        <button id="logoutButton" class="danger-button">
          Logout
        </button>
      </div>
    </header>

    <main>

      <!-- Profile Section -->
      <section class="profile-card">
        <h3>My Profile</h3>
        <p><strong>Name:</strong> <span id="profileName"></span></p>
        <p><strong>Email:</strong> <span id="profileEmail"></span></p>

        <button id="showPasswordButton">
          Change Password
        </button>

        <form id="passwordForm" class="hidden">
          <input
            type="password"
            id="oldPassword"
            placeholder="Current password"
            required
          >

          <input
            type="password"
            id="newPassword"
            placeholder="New password"
            minlength="6"
            required
          >

          <input
            type="password"
            id="confirmPassword"
            placeholder="Confirm new password"
            minlength="6"
            required
          >

          <button type="submit" class="success-button">
            Update Password
          </button>
        </form>
      </section>

      <!-- Courses Section -->
      <section class="card">
        <h2>Available Courses</h2>

        <div class="toolbar">
          <input
            type="search"
            id="searchInput"
            placeholder="Search courses, categories or instructors"
          >
        </div>

        <div id="courseList" class="course-grid"></div>
      </section>

      <!-- Add Course Section -->
      <section class="card">
        <h2>Add New Course</h2>

        <form id="courseForm">
          <input
            type="text"
            id="courseTitle"
            placeholder="Course title"
            required
          >

          <input
            type="text"
            id="courseInstructor"
            placeholder="Instructor name"
            required
          >

          <input
            type="text"
            id="courseCategory"
            placeholder="Category"
            required
          >

          <input
            type="text"
            id="courseDuration"
            placeholder="Duration, e.g. 8 weeks"
            required
          >

          <textarea
            id="courseDescription"
            placeholder="Course description"
            required
          ></textarea>

          <button type="submit">Add Course</button>
        </form>
      </section>

      <!-- Enrollment Section -->
      <section class="card">
        <h2>My Enrolled Courses</h2>
        <div id="enrollmentList"></div>
      </section>

    </main>
  </section>

  <!-- Enrollment Modal -->
  <div id="enrollmentModal" class="login-page hidden">
    <div class="login-box">
      <h2>Enroll in Course</h2>
      <p id="selectedCourse"></p>

      <form id="enrollmentForm">
        <input type="hidden" id="selectedCourseId">

        <input
          type="text"
          id="studentName"
          placeholder="Student name"
          required
        >

        <button type="submit">Enroll Now</button>
        <button type="button" id="closeModal" class="secondary-button">
          Cancel
        </button>
      </form>
    </div>
  </div>

  <div id="message"></div>

  <script>
    const loginPage = document.getElementById("loginPage");
    const appPage = document.getElementById("appPage");
    const loginForm = document.getElementById("loginForm");
    const logoutButton = document.getElementById("logoutButton");
    const themeButton = document.getElementById("themeButton");

    const userInfo = document.getElementById("userInfo");
    const profileName = document.getElementById("profileName");
    const profileEmail = document.getElementById("profileEmail");

    const courseForm = document.getElementById("courseForm");
    const courseList = document.getElementById("courseList");
    const searchInput = document.getElementById("searchInput");

    const passwordForm = document.getElementById("passwordForm");
    const showPasswordButton = document.getElementById("showPasswordButton");

    const enrollmentModal = document.getElementById("enrollmentModal");
    const enrollmentForm = document.getElementById("enrollmentForm");
    const closeModal = document.getElementById("closeModal");
    const selectedCourse = document.getElementById("selectedCourse");
    const selectedCourseId = document.getElementById("selectedCourseId");

    const enrollmentList = document.getElementById("enrollmentList");
    const message = document.getElementById("message");

    const defaultUser = {
      name: "Administrator",
      email: "admin@example.com",
      password: "password123"
    };

    let users = JSON.parse(localStorage.getItem("courseUsers"));

    if (!users) {
      users = [defaultUser];
      localStorage.setItem("courseUsers", JSON.stringify(users));
    }

    let courses = JSON.parse(localStorage.getItem("courseData"));

    if (!courses) {
      courses = [
        {
          id: 1,
          title: "Web Development Fundamentals",
          instructor: "John Smith",
          category: "Web Development",
          duration: "8 weeks",
          description: "Learn HTML, CSS and JavaScript from the beginning."
        },
        {
          id: 2,
          title: "JavaScript Programming",
          instructor: "Mary Johnson",
          category: "Programming",
          duration: "6 weeks",
          description: "Learn variables, functions, arrays, objects and DOM programming."
        },
        {
          id: 3,
          title: "Database Management",
          instructor: "David Brown",
          category: "Database",
          duration: "5 weeks",
          description: "Learn database tables, relationships and SQL queries."
        }
      ];

      localStorage.setItem("courseData", JSON.stringify(courses));
    }

    let currentUser = JSON.parse(sessionStorage.getItem("currentUser"));

    function saveUsers() {
      localStorage.setItem("courseUsers", JSON.stringify(users));
    }

    function saveCourses() {
      localStorage.setItem("courseData", JSON.stringify(courses));
    }

    function showMessage(text) {
      message.textContent = text;
      message.style.display = "block";

      setTimeout(() => {
        message.style.display = "none";
      }, 3000);
    }

    function openApplication() {
      if (!currentUser) {
        loginPage.classList.remove("hidden");
        appPage.classList.add("hidden");
        return;
      }

      loginPage.classList.add("hidden");
      appPage.classList.remove("hidden");

      userInfo.textContent = `Welcome, ${currentUser.name}`;
      profileName.textContent = currentUser.name;
      profileEmail.textContent = currentUser.email;

      loadTheme();
      displayCourses();
      displayEnrollments();
    }

    loginForm.addEventListener("submit", function(event) {
      event.preventDefault();

      const email = document.getElementById("loginEmail").value.trim();
      const password = document.getElementById("loginPassword").value;

      const user = users.find(
        item => item.email === email && item.password === password
      );

      if (!user) {
        showMessage("Invalid email or password.");
        return;
      }

      currentUser = user;
      sessionStorage.setItem("currentUser", JSON.stringify(currentUser));

      loginForm.reset();
      showMessage("Login successful.");
      openApplication();
    });

    logoutButton.addEventListener("click", function() {
      sessionStorage.removeItem("currentUser");
      currentUser = null;

      appPage.classList.add("hidden");
      loginPage.classList.remove("hidden");

      showMessage("You have been logged out.");
    });

    themeButton.addEventListener("click", function() {
      document.body.classList.toggle("dark");

      const isDark = document.body.classList.contains("dark");
      localStorage.setItem("darkTheme", isDark);

      themeButton.textContent = isDark ? "Light Theme" : "Dark Theme";
    });

    function loadTheme() {
      const isDark = localStorage.getItem("darkTheme") === "true";

      document.body.classList.toggle("dark", isDark);
      themeButton.textContent = isDark ? "Light Theme" : "Dark Theme";
    }

    searchInput.addEventListener("input", function() {
      displayCourses(searchInput.value);
    });

    function displayCourses(searchText = "") {
      const search = searchText.toLowerCase();

      const filteredCourses = courses.filter(course => {
        const courseText = `
          ${course.title}
          ${course.instructor}
          ${course.category}
          ${course.description}
        `.toLowerCase();

        return courseText.includes(search);
      });

      courseList.innerHTML = "";

      if (filteredCourses.length === 0) {
        courseList.innerHTML = "<p>No courses found.</p>";
        return;
      }

      filteredCourses.forEach(course => {
        const card = document.createElement("div");
        card.className = "course-card";

        card.innerHTML = `
          <h3>${course.title}</h3>
          <p class="category">${course.category}</p>
          <p><strong>Instructor:</strong> ${course.instructor}</p>
          <p><strong>Duration:</strong> ${course.duration}</p>
          <p>${course.description}</p>
          <button onclick="openEnrollment(${course.id})">
            Enroll Now
          </button>
        `;

        courseList.appendChild(card);
      });
    }

    courseForm.addEventListener("submit", function(event) {
      event.preventDefault();

      const newCourse = {
        id: Date.now(),
        title: document.getElementById("courseTitle").value.trim(),
        instructor: document.getElementById("courseInstructor").value.trim(),
        category: document.getElementById("courseCategory").value.trim(),
        duration: document.getElementById("courseDuration").value.trim(),
        description: document.getElementById("courseDescription").value.trim()
      };

      courses.push(newCourse);
      saveCourses();

      courseForm.reset();
      displayCourses();
      showMessage("Course added successfully.");
    });

    function openEnrollment(courseId) {
      const course = courses.find(item => item.id === courseId);

      if (!course) return;

      selectedCourse.textContent = `Selected course: ${course.title}`;
      selectedCourseId.value = course.id;
      enrollmentModal.classList.remove("hidden");
    }

    closeModal.addEventListener("click", function() {
      enrollmentModal.classList.add("hidden");
      enrollmentForm.reset();
    });

    enrollmentForm.addEventListener("submit", function(event) {
      event.preventDefault();

      const courseId = Number(selectedCourseId.value);
      const course = courses.find(item => item.id === courseId);

      let enrollments = JSON.parse(
        localStorage.getItem("courseEnrollments")
      ) || [];

      const alreadyEnrolled = enrollments.some(item =>
        item.userEmail === currentUser.email &&
        item.courseId === courseId
      );

      if (alreadyEnrolled) {
        showMessage("You are already enrolled in this course.");
        return;
      }

      const enrollment = {
        id: Date.now(),
        userEmail: currentUser.email,
        studentName: document.getElementById("studentName").value.trim(),
        courseId: courseId,
        courseTitle: course.title,
        enrolledDate: new Date().toLocaleDateString()
      };

      enrollments.push(enrollment);
      localStorage.setItem(
        "courseEnrollments",
        JSON.stringify(enrollments)
      );

      enrollmentForm.reset();
      enrollmentModal.classList.add("hidden");

      displayEnrollments();
      showMessage("Enrollment successful.");
    });

    function displayEnrollments() {
      const enrollments = JSON.parse(
        localStorage.getItem("courseEnrollments")
      ) || [];

      const myEnrollments = enrollments.filter(
        item => item.userEmail === currentUser.email
      );

      enrollmentList.innerHTML = "";

      if (myEnrollments.length === 0) {
        enrollmentList.innerHTML = "<p>You have not enrolled in any course.</p>";
        return;
      }

      myEnrollments.forEach(enrollment => {
        const item = document.createElement("div");
        item.className = "enrollment-item";

        item.innerHTML = `
          <div>
            <strong>${enrollment.courseTitle}</strong>
            <p>Student: ${enrollment.studentName}</p>
            <p>Enrolled on: ${enrollment.enrolledDate}</p>
          </div>

          <button
            class="danger-button"
            onclick="removeEnrollment(${enrollment.id})">
            Remove
          </button>
        `;

        enrollmentList.appendChild(item);
      });
    }

    function removeEnrollment(enrollmentId) {
      let enrollments = JSON.parse(
        localStorage.getItem("courseEnrollments")
      ) || [];

      enrollments = enrollments.filter(
        item => item.id !== enrollmentId
      );

      localStorage.setItem(
        "courseEnrollments",
        JSON.stringify(enrollments)
      );

      displayEnrollments();
      showMessage("Enrollment removed.");
    }

    showPasswordButton.addEventListener("click", function() {
      passwordForm.classList.toggle("hidden");

      showPasswordButton.textContent =
        passwordForm.classList.contains("hidden")
          ? "Change Password"
          : "Cancel Password Change";
    });

    passwordForm.addEventListener("submit", function(event) {
      event.preventDefault();

      const oldPassword = document.getElementById("oldPassword").value;
      const newPassword = document.getElementById("newPassword").value;
      const confirmPassword = document.getElementById("confirmPassword").value;

      if (oldPassword !== currentUser.password) {
        showMessage("Current password is incorrect.");
        return;
      }

      if (newPassword !== confirmPassword) {
        showMessage("New passwords do not match.");
        return;
      }

      if (newPassword.length < 6) {
        showMessage("Password must contain at least 6 characters.");
        return;
      }

      currentUser.password = newPassword;

      users = users.map(user =>
        user.email === currentUser.email ? currentUser : user
      );

      saveUsers();
      sessionStorage.setItem("currentUser", JSON.stringify(currentUser));

      passwordForm.reset();
      passwordForm.classList.add("hidden");
      showPasswordButton.textContent = "Change Password";

      showMessage("Password changed successfully.");
    });

    openApplication();
  </script>

</body>
</html>
